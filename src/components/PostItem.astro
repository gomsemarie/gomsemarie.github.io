---
import type { Post } from "@/lib/posts";
import { formatDate, formatMonthDay, postHref } from "@/lib/posts";
import { categoryDisplay } from "@/lib/taxonomy";

interface Props {
  post: Post;
  /** 연도별 목록에서는 월.일만, 그 외에는 전체 날짜 */
  shortDate?: boolean;
}

const { post, shortDate = false } = Astro.props;
const { data } = post;
---

<article class="group relative rounded-[var(--radius-lg)] px-4 py-5 transition-colors hover:bg-surface sm:px-5">
  <div class="flex flex-wrap items-center gap-2">
    <span class="pd-tag pd-tag--primary">{categoryDisplay(data.category)}</span>
    {data.series && <span class="pd-tag">시리즈 {data.seriesOrder ? `${data.seriesOrder}편` : ""}</span>}
    {data.draft && <span class="pd-tag">초안</span>}
  </div>
  <h3 class="mt-3 font-display text-[20px] leading-[1.4] text-ink">
    <a href={postHref(post)} class="after:absolute after:inset-0 after:rounded-[var(--radius-lg)] group-hover:text-primary-ink">{data.title}</a>
  </h3>
  <p class="mt-1.5 text-[15px] leading-[1.7] text-ink-muted">{data.description}</p>
  <p class="mt-3 flex flex-wrap gap-x-3 text-[13px] text-ink-muted">
    <time datetime={data.date.toISOString()} class="tabular-nums">{shortDate ? formatMonthDay(data.date) : formatDate(data.date)}</time>
    <span>{post.minutesRead}분</span>
    {data.tags.slice(0, 3).map((t) => <span>#{t.toLowerCase()}</span>)}
  </p>
</article>
