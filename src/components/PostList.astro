---
import PostItem from "@/components/PostItem.astro";
import type { Post } from "@/lib/posts";
import { groupByYear } from "@/lib/taxonomy";

interface Props {
  posts: Post[];
}

const groups = groupByYear(Astro.props.posts);
---

{
  groups.length === 0 ? (
    <p class="py-12 text-center text-ink-muted">글이 없습니다.</p>
  ) : (
    groups.map((g, i) => (
      <section aria-label={`${g.year}년 글`} class:list={[i > 0 && "mt-10"]}>
        <h2 class="mb-1.5 flex items-center gap-2 font-display text-[17px] text-primary-ink">
          <span class="size-2 rounded-full bg-primary" aria-hidden="true" />
          {g.year}
        </h2>
        {g.posts.map((post) => (
          <PostItem post={post} shortDate />
        ))}
      </section>
    ))
  )
}
