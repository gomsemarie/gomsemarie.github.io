---
import SearchPalette from "@/components/react/SearchPalette";
import ThemeToggle from "@/components/react/ThemeToggle";
import { SITE } from "@/config/site";
import { getPosts } from "@/lib/posts";
import { tagCounts } from "@/lib/taxonomy";

const NAV = [
  { href: "/", label: "글", match: (p: string) => p === "/" || p.startsWith("/posts/") || p.startsWith("/categories/") },
  { href: "/series/", label: "시리즈", match: (p: string) => p.startsWith("/series/") },
  { href: "/tags/", label: "태그", match: (p: string) => p.startsWith("/tags/") },
  { href: "/about/", label: "소개", match: (p: string) => p.startsWith("/about/") },
];

const path = Astro.url.pathname;
const tags = tagCounts(await getPosts());
---

<header class="sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[1120px] items-center justify-between gap-4 px-5 md:px-8">
    <a href="/" class="font-mono text-[17px] font-medium tracking-tight hover:text-foreground">
      gomsemarie<span class="text-accent">.</span>
    </a>

    <nav aria-label="주 메뉴" class="hidden items-center gap-1 md:flex">
      {
        NAV.map((item) => {
          const active = item.match(path);
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-lg px-3 py-2 text-[15px]",
                active ? "font-semibold text-foreground" : "text-muted-foreground hover:text-foreground",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-1 md:gap-2">
      <SearchPalette client:idle tags={tags} />
      <ThemeToggle client:load />
      <a
        href={SITE.github}
        aria-label="GitHub"
        class="hidden size-10 place-items-center rounded-lg text-foreground hover:bg-muted-strong md:grid"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path></svg>
      </a>

      <details class="group relative md:hidden">
        <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-lg hover:bg-muted-strong [&::-webkit-details-marker]:hidden" aria-label="메뉴 열기">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        </summary>
        <nav aria-label="모바일 메뉴" class="absolute right-0 top-12 flex w-44 flex-col rounded-xl border border-border bg-surface p-2 shadow-lg">
          {
            NAV.map((item) => (
              <a href={item.href} class:list={["rounded-lg px-3 py-2.5 text-[15px]", item.match(path) ? "font-semibold" : "text-muted-foreground"]}>
                {item.label}
              </a>
            ))
          }
          <a href={SITE.github} class="rounded-lg px-3 py-2.5 text-[15px] text-muted-foreground" target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
      </details>
    </div>
  </div>
</header>
