---
import type { CategoryNode } from "@/lib/taxonomy";
import { categoryHref } from "@/lib/taxonomy";

interface Props {
  tree: CategoryNode[];
  total: number;
  /** 현재 선택된 최상위 카테고리 경로 슬러그 (없으면 전체) */
  active?: string;
}

const { tree, total, active } = Astro.props;
const items = [{ href: "/", label: "전체", count: total, on: !active }, ...tree.map((n) => ({ href: categoryHref(n.path), label: n.label, count: n.count, on: active === n.path[0] }))];
---

<nav aria-label="카테고리" class="mb-8 flex flex-wrap gap-2">
  {
    items.map((item) => (
      <a
        href={item.href}
        aria-current={item.on ? "page" : undefined}
        class:list={[
          "inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 text-sm",
          item.on ? "bg-primary font-semibold text-on-primary" : "border-[1.5px] border-line bg-surface text-ink-muted hover:bg-primary-soft hover:text-primary-ink",
        ]}
      >
        {item.label}
        <span class="font-mono text-xs tabular-nums opacity-70">{item.count}</span>
      </a>
    ))
  }
</nav>
