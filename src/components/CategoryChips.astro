---
import type { CategoryNode } from "@/lib/taxonomy";
import { categoryHref } from "@/lib/taxonomy";
import { CATEGORIES, ROLE_CLASSES } from "@/config/categories";

interface Props {
  tree: CategoryNode[];
  total: number;
  /** 현재 선택된 최상위 카테고리 경로 슬러그 (없으면 전체) */
  active?: string;
}

const { tree, total, active } = Astro.props;
const items = [
  { href: "/", label: "전체", count: total, on: !active, dot: undefined },
  ...tree.map((n) => ({
    href: categoryHref(n.path),
    label: n.label,
    count: n.count,
    on: active === n.path[0],
    dot: ROLE_CLASSES[CATEGORIES[n.name]?.role ?? "primary"].dot,
  })),
];
---

<nav aria-label="카테고리" class="flex flex-wrap gap-2">
  {
    items.map((item) => (
      <a
        href={item.href}
        aria-current={item.on ? "page" : undefined}
        class:list={[
          "inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 text-sm",
          item.on ? "bg-primary font-semibold text-on-primary" : "bg-sunken text-ink-muted hover:bg-primary-soft hover:text-primary-ink",
        ]}
      >
        {item.dot && <span class:list={["size-2 rounded-full", item.dot]} aria-hidden="true" />}
        {item.label}
        <span class="font-mono text-xs tabular-nums opacity-70">{item.count}</span>
      </a>
    ))
  }
</nav>
