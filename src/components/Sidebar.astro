---
import type { Post } from "@/lib/posts";
import { getSeries, tagCounts } from "@/lib/taxonomy";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const series = getSeries(posts).slice(0, 2);
const tags = tagCounts(posts).slice(0, 10);
const heading = "mb-3 font-display text-[16px] text-primary-ink";
---

<aside class="flex flex-[1_1_260px] flex-col gap-10">
  {
    series.length > 0 && (
      <section>
        <h2 class={heading}>시리즈</h2>
        <div class="flex flex-col gap-3">
          {series.map((s) => (
            <a href={`/series/${s.slug}/`} class="pd-card p-5">
              <span class="pd-tag pd-tag--primary">{s.posts.length}편</span>
              <p class="mt-3 font-display text-[17px] leading-[1.4] text-ink">{s.name}</p>
              <ol class="mt-3 grid gap-2 text-sm leading-normal text-ink-muted">
                {s.posts.map((p, i) => (
                  <li class="grid grid-cols-[22px_minmax(0,1fr)] gap-2">
                    <span class="grid size-[22px] place-items-center rounded-full bg-primary font-display text-[12px] text-on-primary">{i + 1}</span>
                    <span class="pt-px">{p.data.title.split(" — ")[0]}</span>
                  </li>
                ))}
              </ol>
            </a>
          ))}
        </div>
      </section>
    )
  }
  <section>
    <h2 class={heading}>자주 쓴 태그</h2>
    <div class="flex flex-wrap gap-2">
      {
        tags.map((t) => (
          <a href={`/tags/${t.slug}/`} class="pd-tag">
            #{t.tag} <span class="opacity-70">{t.count}</span>
          </a>
        ))
      }
    </div>
    <a href="/tags/" class="mt-4 inline-block text-[13px] font-semibold text-primary-ink">모든 태그 →</a>
  </section>
  <section class="rounded-[var(--radius-md)] border-[1.5px] border-line bg-sunken p-5">
    <h2 class="font-display text-[16px] text-ink">RSS</h2>
    <a href="/rss.xml" class="mt-1 inline-block font-mono text-[13px] text-primary-ink">gomsemarie.github.io/rss.xml</a>
  </section>
</aside>
