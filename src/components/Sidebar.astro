---
import type { Post } from "@/lib/posts";
import { getSeries, tagCounts } from "@/lib/taxonomy";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const series = getSeries(posts).slice(0, 2);
const tags = tagCounts(posts).slice(0, 10);
---

<aside class="flex flex-[1_1_260px] flex-col gap-12">
  {
    series.length > 0 && (
      <section>
        <h2 class="mb-4 text-sm font-semibold">시리즈</h2>
        <div class="flex flex-col gap-3">
          {series.map((s) => (
            <a href={`/series/${s.slug}/`} class="block rounded-xl border border-border bg-surface p-5 hover:border-foreground">
              <p class="font-mono text-xs text-accent">SERIES · {s.posts.length}편</p>
              <p class="mt-2 font-semibold leading-[1.45]">{s.name}</p>
              <ol class="mt-3 list-decimal pl-[18px] text-sm leading-[1.8] text-muted-foreground">
                {s.posts.map((p) => (
                  <li>{p.data.title.split(" — ")[0]}</li>
                ))}
              </ol>
            </a>
          ))}
        </div>
      </section>
    )
  }
  <section>
    <h2 class="mb-4 text-sm font-semibold">자주 쓴 태그</h2>
    <div class="flex flex-wrap gap-x-3.5 gap-y-1.5 font-mono text-[13px]">
      {
        tags.map((t) => (
          <a href={`/tags/${t.slug}/`} class="text-muted-foreground hover:text-accent">
            #{t.tag} <span class="text-subtle-foreground">{t.count}</span>
          </a>
        ))
      }
    </div>
    <a href="/tags/" class="mt-4 inline-block text-[13px] text-accent">모든 태그 →</a>
  </section>
  <section class="rounded-xl bg-muted p-5">
    <h2 class="text-sm font-semibold">RSS</h2>
    <a href="/rss.xml" class="mt-2 inline-block font-mono text-[13px] text-accent">gomsemarie.github.io/rss.xml</a>
  </section>
</aside>
