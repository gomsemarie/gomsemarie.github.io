---
import { SITE } from "@/config/site";
const year = new Date().getFullYear();
---

<footer class="border-t-[1.5px] border-line">
  <div class="mx-auto flex max-w-[1180px] flex-wrap justify-between gap-4 px-4 py-8 text-[13px] text-ink-muted md:px-8">
    <span>© {year} {SITE.author}</span>
    <span class="flex gap-5">
      <a href="/rss.xml" class="hover:text-ink">RSS</a>
      <a href={SITE.github} class="hover:text-ink" target="_blank" rel="noopener noreferrer">GitHub</a>
      <span>Built with Astro</span>
    </span>
  </div>
</footer>
