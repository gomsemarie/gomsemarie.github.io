---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import type { Post } from "@/lib/posts";

interface Props {
  title: string;
  eyebrow: string;
  description?: string;
  posts: Post[];
}

const { title, eyebrow, description, posts } = Astro.props;
---

<BaseLayout title={title} description={description ?? `${title} — 글 ${posts.length}편`}>
  <div class="mx-auto max-w-[1180px] px-4 pb-24 pt-14 md:px-8 md:pt-[72px]">
    <div class="pd-dots" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="mt-4"><span class="pd-tag pd-tag--primary">{eyebrow}</span></p>
    <h1 class="mt-3 font-display text-[32px] leading-[1.3] text-ink md:text-[40px]">{title}</h1>
    <p class="mt-2 text-[16px] text-ink-muted">{description ?? `글 ${posts.length}편`}</p>
    <slot />
    <div class="mt-10 max-w-[760px]">
      <PostList posts={posts} />
    </div>
  </div>
</BaseLayout>
