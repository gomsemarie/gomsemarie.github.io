---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import type { Post } from "@/lib/posts";

interface Props {
  title: string;
  eyebrow: string;
  description?: string;
  posts: Post[];
}

const { title, eyebrow, description, posts } = Astro.props;
---

<BaseLayout title={title} description={description ?? `${title} — 글 ${posts.length}편`}>
  <div class="mx-auto max-w-[1120px] px-5 pb-24 pt-14 md:px-8 md:pt-[72px]">
    <p class="font-mono text-[13px] tracking-[0.04em] text-accent">{eyebrow}</p>
    <h1 class="mt-3 text-[32px] font-bold tracking-[-0.03em] md:text-[40px]">{title}</h1>
    <p class="mt-3 text-[17px] text-muted-foreground">{description ?? `글 ${posts.length}편`}</p>
    <slot />
    <div class="mt-12 max-w-[760px]">
      <PostList posts={posts} />
    </div>
  </div>
</BaseLayout>
