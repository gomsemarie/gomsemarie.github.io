---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="페이지가 없습니다">
  <div class="mx-auto max-w-[720px] px-5 py-32 text-center md:px-8">
    <div class="pd-dots justify-center" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="mt-4"><span class="pd-tag pd-tag--primary">404</span></p>
    <h1 class="mt-3 font-display text-[32px] text-ink">페이지가 없습니다</h1>
    <p class="mt-4 text-ink-muted">주소를 다시 확인하거나 검색(⌘K)해 보세요.</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-primary px-6 py-2.5 text-sm font-semibold text-on-primary">홈으로</a>
  </div>
</BaseLayout>
