---
import type { GetStaticPaths, Page } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CategoryChips from "@/components/CategoryChips.astro";
import Pagination from "@/components/Pagination.astro";
import PostList from "@/components/PostList.astro";
import { getPosts, type Post } from "@/lib/posts";
import { buildCategoryTree } from "@/lib/taxonomy";

/** 홈(/) 과 /2/, /3/ … 페이지 */
export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getPosts(), { pageSize: 15 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const posts = await getPosts();
const tree = buildCategoryTree(posts);
const isFirst = page.currentPage === 1;
---

<BaseLayout title={isFirst ? undefined : `글 목록 ${page.currentPage}페이지`}>
  <div class="mx-auto max-w-[808px] px-6 pb-24 pt-12 md:pt-14">
    {
      isFirst && (
        <section class="mb-8 flex flex-wrap items-center gap-5">
          <img
            src="https://github.com/gomsemarie.png?size=128"
            alt=""
            width="64"
            height="64"
            class="size-16 flex-none rounded-full border-[3px] border-primary bg-primary-soft"
            loading="eager"
          />
          <div class="min-w-0 flex-[1_1_300px]">
            <h1 class="font-display text-[30px] leading-[1.3] text-ink md:text-[32px]">프론트엔드 개발 노트</h1>
            <p class="mt-1 text-[15px] text-ink-muted">React, Next.js, 배포 같은 걸 다루다가 정리해 둘 만한 게 생기면 올린다.</p>
          </div>
        </section>
      )
    }

    <CategoryChips tree={tree} total={posts.length} />

    <section aria-label="글 목록" class="mt-10">
      <PostList posts={page.data} />
      <Pagination page={page} />
    </section>
  </div>
</BaseLayout>
