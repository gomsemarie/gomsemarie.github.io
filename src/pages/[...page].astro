---
import type { GetStaticPaths, Page } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CategoryChips from "@/components/CategoryChips.astro";
import Pagination from "@/components/Pagination.astro";
import PostList from "@/components/PostList.astro";
import Sidebar from "@/components/Sidebar.astro";
import { SITE } from "@/config/site";
import { getPosts, type Post } from "@/lib/posts";
import { buildCategoryTree } from "@/lib/taxonomy";

/** 홈(/) 과 /2/, /3/ … 페이지 */
export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getPosts(), { pageSize: 15 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const posts = await getPosts();
const tree = buildCategoryTree(posts);
const isFirst = page.currentPage === 1;
---

<BaseLayout title={isFirst ? undefined : `글 목록 ${page.currentPage}페이지`}>
  <div class="mx-auto max-w-[1180px] px-4 md:px-8">
    {
      isFirst && (
        <section class="pd-panel mt-8 px-6 py-10 md:mt-12 md:px-12 md:py-14">
          <div class="pd-dots" aria-hidden="true"><i></i><i></i><i></i></div>
          <h1 class="mt-5 font-display text-[36px] leading-[1.25] text-ink md:text-[48px]">프론트엔드 개발 노트</h1>
          <p class="mt-4 max-w-[560px] text-[16px] leading-[1.75] text-ink-muted">
            React, Next.js, 배포 같은 걸 다루다가 정리해 둘 만한 게 생기면 올린다.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            <a href="/about/" class="pd-tag pd-tag--primary">소개</a>
            <a href="/rss.xml" class="pd-tag">RSS</a>
            <a href={SITE.github} class="pd-tag" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </section>
      )
    }

    <div class:list={["flex flex-wrap gap-[72px] pb-24", isFirst ? "pt-12" : "pt-14 md:pt-[72px]"]}>
      <section aria-label="글 목록" class="min-w-0 flex-[999_1_560px]">
        <CategoryChips tree={tree} total={posts.length} />
        <PostList posts={page.data} />
        <Pagination page={page} />
      </section>
      <Sidebar posts={posts} />
    </div>
  </div>
</BaseLayout>
