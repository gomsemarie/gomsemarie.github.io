---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, formatMonthDay } from "@/lib/posts";
import { buildCategoryTree, categoryHref, getSeries, tagCounts } from "@/lib/taxonomy";

const posts = await getPosts();
const tree = buildCategoryTree(posts);
const tags = tagCounts(posts);
const series = getSeries(posts);
const heading = "mb-4 font-display text-[18px] text-primary-ink";
---

<BaseLayout title="카테고리와 태그" description="모든 카테고리, 태그, 시리즈 모아보기">
  <div class="mx-auto max-w-[1180px] px-4 pb-24 pt-14 md:px-8 md:pt-[72px]">
    <div class="pd-dots" aria-hidden="true"><i></i><i></i><i></i></div>
    <h1 class="mt-4 font-display text-[32px] text-ink md:text-[40px]">카테고리와 태그</h1>
    <p class="mt-2 text-[16px] text-ink-muted">
      글 {posts.length}편 · 카테고리 {tree.length}개 · 태그 {tags.length}개 · 시리즈 {series.length}개
    </p>

    <div class="mt-12 flex flex-wrap gap-10 lg:gap-14">
      <section aria-label="카테고리" class="flex-[1_1_280px]">
        <h2 class={heading}>카테고리</h2>
        <ul class="grid gap-2">
          {
            tree.map((node) => (
              <li class="rounded-[var(--radius-md)] border-[1.5px] border-line bg-surface p-2">
                <a href={categoryHref(node.path)} class="flex items-center justify-between rounded-full px-3 py-1.5 font-semibold hover:bg-primary-soft hover:text-primary-ink">
                  {node.label} <span class="pd-tag pd-tag--primary">{node.count}</span>
                </a>
                {node.children.length > 0 && (
                  <ul class="mt-1 grid gap-0.5 pl-3 text-sm">
                    {node.children.map((c) => (
                      <li>
                        <a href={categoryHref(c.path)} class="flex items-center justify-between rounded-full px-3 py-1.5 text-ink-muted hover:bg-primary-soft hover:text-primary-ink">
                          <span class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-primary" aria-hidden="true" />{c.label}</span>
                          <span class="text-xs tabular-nums">{c.count}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <div class="flex min-w-0 flex-[999_1_560px] flex-col gap-12">
        <section aria-label="태그">
          <h2 class={heading}>태그</h2>
          <div class="flex flex-wrap gap-2">
            {
              tags.map((t) => (
                <a href={`/tags/${t.slug}/`} class="pd-tag">
                  #{t.tag} <span class="opacity-70">{t.count}</span>
                </a>
              ))
            }
          </div>
        </section>

        {
          series.length > 0 && (
            <section aria-label="시리즈" id="series">
              <h2 class={heading}>시리즈</h2>
              <div class="flex flex-col gap-3">
                {series.map((s) => (
                  <a href={`/series/${s.slug}/`} class="pd-card flex flex-wrap gap-6 p-6">
                    <div class="flex-[1_1_220px]">
                      <span class="pd-tag pd-tag--primary">{s.posts.length}편</span>
                      <p class="mt-3 font-display text-[20px] text-ink">{s.name}</p>
                    </div>
                    <ol class="grid flex-[1_1_260px] gap-2 text-sm text-ink-muted">
                      {s.posts.map((p, i) => (
                        <li class="grid grid-cols-[22px_minmax(0,1fr)] gap-2">
                          <span class="grid size-[22px] place-items-center rounded-full bg-primary font-display text-[12px] text-on-primary">{i + 1}</span>
                          <span class="pt-px">
                            {p.data.title.split(" — ")[0]} <span class="text-xs tabular-nums">{formatMonthDay(p.data.date)}</span>
                          </span>
                        </li>
                      ))}
                    </ol>
                  </a>
                ))}
              </div>
            </section>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
