---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostItem from "@/components/PostItem.astro";
import { getPosts } from "@/lib/posts";
import { getSeries } from "@/lib/taxonomy";

export async function getStaticPaths() {
  return getSeries(await getPosts()).map((s) => ({ params: { series: s.slug }, props: { series: s } }));
}

const { series } = Astro.props;
---

<BaseLayout title={series.name} description={`${series.name} — 시리즈 ${series.posts.length}편`}>
  <div class="mx-auto max-w-[1120px] px-5 pb-24 pt-14 md:px-8 md:pt-[72px]">
    <p class="font-mono text-[13px] tracking-[0.04em] text-accent">SERIES · {series.posts.length}편</p>
    <h1 class="mt-3 text-[32px] font-bold tracking-[-0.03em] text-balance md:text-[40px]">{series.name}</h1>
    <p class="mt-3 text-[17px] text-muted-foreground">순서대로 읽는 것을 추천해요.</p>
    <ol class="mt-12 max-w-[760px]">
      {
        series.posts.map((post) => (
          <li>
            <PostItem post={post} />
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
