---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostItem from "@/components/PostItem.astro";
import { getPosts } from "@/lib/posts";
import { getSeries } from "@/lib/taxonomy";

export async function getStaticPaths() {
  return getSeries(await getPosts()).map((s) => ({ params: { series: s.slug }, props: { series: s } }));
}

const { series } = Astro.props;
---

<BaseLayout title={series.name} description={`${series.name} — 시리즈 ${series.posts.length}편`}>
  <div class="mx-auto max-w-[1180px] px-4 pb-24 pt-14 md:px-8 md:pt-[72px]">
    <div class="pd-dots" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="mt-4"><span class="pd-tag pd-tag--primary">시리즈 · {series.posts.length}편</span></p>
    <h1 class="mt-3 font-display text-[32px] text-ink md:text-[40px]">{series.name}</h1>
    <ol class="-mx-4 mt-10 max-w-[792px] sm:-mx-5">
      {
        series.posts.map((post) => (
          <li>
            <PostItem post={post} />
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
