---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, getPosts } from "@/lib/posts";
import { getSeries } from "@/lib/taxonomy";

const series = getSeries(await getPosts());
---

<BaseLayout title="시리즈" description="연재 글 모음">
  <div class="mx-auto max-w-[1180px] px-4 pb-24 pt-14 md:px-8 md:pt-[72px]">
    <div class="pd-dots" aria-hidden="true"><i></i><i></i><i></i></div>
    <h1 class="mt-4 font-display text-[32px] text-ink md:text-[40px]">시리즈</h1>
    <p class="mt-2 text-[16px] text-ink-muted">연재 {series.length}개</p>

    <div class="mt-12 flex max-w-[760px] flex-col gap-4">
      {
        series.length === 0 ? (
          <p class="text-ink-muted">시리즈가 없습니다.</p>
        ) : (
          series.map((s) => (
            <a href={`/series/${s.slug}/`} class="pd-card p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h2 class="font-display text-[22px] text-ink">{s.name}</h2>
                <span class="pd-tag pd-tag--primary">{s.posts.length}편</span>
              </div>
              <p class="mt-1 text-[13px] tabular-nums text-ink-muted">
                {formatDate(s.posts[0].data.date)} – {formatDate(s.posts.at(-1)!.data.date)}
              </p>
            </a>
          ))
        )
      }
    </div>
  </div>
</BaseLayout>
