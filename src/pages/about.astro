---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config/site";
// 소개 본문은 src/content/about.md에서 수정한다
import { Content as About } from "@/content/about.md";
---

<BaseLayout title="소개" description={SITE.description}>
  <div class="px-4 pb-24 pt-10 md:pt-14">
    <div class="pd-panel mx-auto max-w-[760px] px-6 py-10 md:px-12">
      <img
        src="https://github.com/gomsemarie.png?size=160"
        alt="gomsemarie 프로필 사진"
        width="80"
        height="80"
        class="rounded-full border-[3px] border-primary"
        loading="lazy"
      />
      <h1 class="mt-5 font-display text-[36px] text-ink md:text-[40px]">gomsemarie</h1>
      <div class="prose-blog mt-4">
        <About />
      </div>
      <div class="mt-8 flex flex-wrap gap-2">
        <a href={SITE.github} class="pd-tag pd-tag--primary" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="/rss.xml" class="pd-tag">RSS</a>
      </div>
    </div>
  </div>
</BaseLayout>
