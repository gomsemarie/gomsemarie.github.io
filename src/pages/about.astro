---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config/site";
// 소개 본문은 src/content/about.md에서 수정한다
import { Content as About } from "@/content/about.md";
---

<BaseLayout title="소개" description={SITE.description}>
  <div class="mx-auto max-w-[720px] px-5 pb-24 pt-14 md:px-8 md:pt-[72px]">
    <img
      src="https://github.com/gomsemarie.png?size=160"
      alt="gomsemarie 프로필 사진"
      width="80"
      height="80"
      class="rounded-full border border-border"
      loading="lazy"
    />
    <h1 class="mt-6 text-[32px] font-bold tracking-[-0.03em] md:text-[40px]">gomsemarie</h1>
    <div class="prose-blog mt-6">
      <About />
    </div>
    <ul class="mt-10 flex flex-wrap gap-3 text-sm">
      <li><a href={SITE.github} class="block rounded-lg border border-border px-4 py-2.5 hover:border-foreground" target="_blank" rel="noopener noreferrer">GitHub</a></li>
      <li><a href="/rss.xml" class="block rounded-lg border border-border px-4 py-2.5 hover:border-foreground">RSS</a></li>
    </ul>
  </div>
</BaseLayout>
