---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TocSpy from "@/components/react/TocSpy";
import Comments from "@/components/react/Comments";
import { GISCUS, SITE } from "@/config/site";
import { formatDate, getPosts, postHref, type Post } from "@/lib/posts";
import {
  categoryHref,
  categoryLabel,
  categorySegments,
  categoryDisplay,
  getSeries,
  prevNext,
  relatedPosts,
  slugify,
} from "@/lib/taxonomy";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;
const posts = await getPosts();
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const segments = categorySegments(data.category);
const series = data.series ? getSeries(posts).find((s) => s.name === data.series) : undefined;
const seriesIndex = series?.posts.findIndex((p) => p.slug === post.slug) ?? -1;
const { prev, next } = prevNext(post, posts);
const related = relatedPosts(post, posts, 3);
const editUrl = `${SITE.repo}/edit/develop/${post.filePath}`;
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={`/og/${post.slug}.png`}
  type="article"
  publishedTime={data.date}
>
  <div slot="top" aria-hidden="true" class="fixed inset-x-0 top-0 z-50 h-[3px]">
    <div id="reading-progress" class="h-full origin-left scale-x-0 rounded-r-full bg-primary-ink"></div>
  </div>

  <!-- DocShell: 왼쪽 목차 + 오른쪽 읽기 패널 -->
  <div class="mx-auto grid max-w-[1180px] items-start gap-8 px-4 pb-20 pt-8 md:px-8 md:pt-10 lg:grid-cols-[240px_minmax(0,1fr)]">
    <aside aria-label="목차" class="sticky top-24 hidden max-h-[calc(100vh-7rem)] overflow-y-auto lg:block">
      {
        toc.length > 0 && (
          <>
            <p class="px-3.5 pb-2 font-display text-[15px] text-primary-ink">목차</p>
            <TocSpy client:idle headings={toc.map(({ depth, slug, text }) => ({ depth, slug, text }))} />
          </>
        )
      }
      <div class="mt-6 grid gap-0.5 border-t-[1.5px] border-dashed border-line-strong pt-4 text-[13px]">
        <a href="#main" class="rounded-full px-3.5 py-1.5 text-ink-muted hover:bg-sunken hover:text-ink">↑ 맨 위로</a>
        <a href={editUrl} class="rounded-full px-3.5 py-1.5 text-ink-muted hover:bg-sunken hover:text-ink" target="_blank" rel="noopener noreferrer">GitHub에서 수정하기</a>
      </div>
    </aside>

    <article class="pd-panel min-w-0 px-5 py-8 sm:px-8 md:px-12 md:py-10">
      <nav aria-label="경로" class="flex flex-wrap gap-2">
        {
          segments.map((seg, i) => (
            <a href={categoryHref(segments.slice(0, i + 1))} class:list={["pd-tag", i === segments.length - 1 && "pd-tag--primary"]}>
              {categoryLabel(seg, i)}
            </a>
          ))
        }
      </nav>

      <div data-pagefind-body>
        <div class="pd-dots mt-6" aria-hidden="true"><i></i><i></i><i></i></div>
        <h1 class="mt-4 font-display text-[28px] leading-[1.35] text-ink md:text-[36px] md:leading-[1.3]" data-pagefind-meta="title">
          {data.title}
        </h1>
        <p class="mt-4 max-w-[72ch] text-[16px] leading-[1.75] text-ink-muted">{data.description}</p>
      </div>

      <div class="mt-5 flex flex-wrap gap-x-3 gap-y-1 border-b-[1.5px] border-dashed border-line-strong pb-7 text-[13px] text-ink-muted">
        <time datetime={data.date.toISOString()} class="tabular-nums">{formatDate(data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{post.minutesRead}분 읽기</span>
        {
          data.updated && (
            <>
              <span aria-hidden="true">·</span>
              <span class="tabular-nums">수정 {formatDate(data.updated)}</span>
            </>
          )
        }
      </div>

      {
        series && (
          <section aria-label="시리즈" class="mt-7 grid gap-3 rounded-[var(--radius-md)] border-[1.5px] border-line bg-primary-soft px-5 py-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span class="rounded-full bg-surface px-2.5 py-1 text-xs font-semibold text-primary-ink">시리즈 {seriesIndex + 1} / {series.posts.length}</span>
              <a href={`/series/${series.slug}/`} class="font-display text-[16px] text-ink hover:text-primary-ink">
                {series.name}
              </a>
            </div>
            <ol class="grid gap-2 text-sm">
              {series.posts.map((p, i) => (
                <li class="grid grid-cols-[24px_minmax(0,1fr)] items-start gap-2.5">
                  <span class="grid size-6 place-items-center rounded-full bg-primary font-display text-[12px] text-on-primary">{i + 1}</span>
                  {p.slug === post.slug ? (
                    <span class="pt-0.5 font-semibold text-ink">{p.data.title} <span class="font-normal text-primary-ink">· 지금 읽는 글</span></span>
                  ) : (
                    <a href={postHref(p)} class="pt-0.5 text-ink-muted hover:text-primary-ink">{p.data.title}</a>
                  )}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        toc.length > 0 && (
          <details class="mt-7 rounded-[var(--radius-md)] border-[1.5px] border-line bg-sunken lg:hidden">
            <summary class="cursor-pointer px-4 py-3 font-display text-[15px] text-primary-ink">목차</summary>
            <ol class="grid gap-1 px-4 pb-4 text-sm">
              {toc.map((h) => (
                <li class:list={[h.depth === 3 && "pl-4"]}>
                  <a href={`#${h.slug}`} class="text-ink-muted hover:text-primary-ink">{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      <div class="prose-blog mt-9" data-pagefind-body>
        <Content />
      </div>

      {
        data.tags.length > 0 && (
          <div class="mt-12 flex flex-wrap gap-2">
            {data.tags.map((t) => (
              <a href={`/tags/${slugify(t)}/`} class="pd-tag">#{t.toLowerCase()}</a>
            ))}
          </div>
        )
      }

      <nav aria-label="이전·다음 글" class="mt-10 grid gap-3 sm:grid-cols-2">
        {
          prev ? (
            <a href={postHref(prev)} class="pd-card rounded-[var(--radius-md)] p-5">
              <span class="text-[13px] text-ink-muted">← 이전 글</span>
              <span class="mt-1.5 block font-display text-[16px] leading-[1.45] text-ink">{prev.data.title}</span>
            </a>
          ) : (
            <span class="hidden sm:block" />
          )
        }
        {
          next && (
            <a href={postHref(next)} class="pd-card rounded-[var(--radius-md)] p-5 text-right">
              <span class="text-[13px] text-ink-muted">다음 글 →</span>
              <span class="mt-1.5 block font-display text-[16px] leading-[1.45] text-ink">{next.data.title}</span>
            </a>
          )
        }
      </nav>

      {
        GISCUS.repoId && GISCUS.categoryId && (
          <section aria-label="댓글" class="mt-12 border-t-[1.5px] border-dashed border-line-strong pt-10">
            <h2 class="mb-4 font-display text-[22px] text-ink">댓글</h2>
            <Comments client:idle />
          </section>
        )
      }
    </article>
  </div>

  {
    related.length > 0 && (
      <section class="mx-auto max-w-[1180px] px-4 pb-20 md:px-8">
        <h2 class="mb-4 flex items-center gap-2 font-display text-[20px] text-ink">
          <span class="size-2 rounded-full bg-primary" aria-hidden="true" />관련 글
        </h2>
        <div class="grid gap-4 md:grid-cols-3">
          {related.map((p) => (
            <a href={postHref(p)} class="pd-card p-5">
              <span class="pd-tag pd-tag--primary">{categoryDisplay(p.data.category)}</span>
              <span class="mt-3 block font-display text-[17px] leading-[1.45] text-ink">{p.data.title}</span>
              <span class="mt-3 block text-[13px] tabular-nums text-ink-muted">
                {formatDate(p.data.date)} · {p.minutesRead}분
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  import mediumZoom, { type Zoom } from "medium-zoom";

  // 페이지 전환(ClientRouter) 환경: 스크립트는 한 번만 실행되므로 astro:page-load마다 다시 연결한다
  let frame = 0;
  let zoom: Zoom | undefined;

  const update = () => {
    frame = 0;
    const bar = document.getElementById("reading-progress");
    const article = document.querySelector<HTMLElement>("article .prose-blog");
    if (!bar || !article) return;
    const { top, height } = article.getBoundingClientRect();
    const progress = Math.min(1, Math.max(0, -top / Math.max(1, height - window.innerHeight)));
    bar.style.transform = `scaleX(${progress})`;
  };

  window.addEventListener("scroll", () => (frame ||= requestAnimationFrame(update)), { passive: true });

  document.addEventListener("astro:page-load", () => {
    zoom?.detach();
    zoom = mediumZoom(".prose-blog .md-figure img", { margin: 24, background: "var(--canvas)" });
    update();
  });
</script>
